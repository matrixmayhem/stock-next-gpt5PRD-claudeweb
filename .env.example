# Application
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NODE_ENV=development

# Payload
PAYLOAD_SECRET=your-secret-key-here-change-in-production

# Database (Postgres)
DATABASE_URI=postgresql://user:password@localhost:5432/transparent_logbook

# S3 Storage (for media and WORM compliance)
S3_REGION=ap-south-1
S3_BUCKET=transparent-logbook-storage
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com

# S3 WORM Compliance Bucket (separate bucket with Object Lock enabled)
S3_WORM_BUCKET=transparent-logbook-worm
S3_WORM_RETENTION_DAYS=1825

# Stripe (Payment Processing)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# KYC Provider (choose one: signzy, hyperverge, idfy)
KYC_PROVIDER=signzy
KYC_API_KEY=your-kyc-api-key
KYC_API_SECRET=your-kyc-api-secret
KYC_WEBHOOK_SECRET=your-webhook-secret

# Zoom (for webinar integration)
ZOOM_CLIENT_ID=your-zoom-client-id
ZOOM_CLIENT_SECRET=your-zoom-client-secret
ZOOM_WEBHOOK_SECRET_TOKEN=your-webhook-secret

# Email (for notifications - optional, use SendGrid, AWS SES, etc.)
EMAIL_FROM=noreply@transparentlogbook.com
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key

# SEBI Compliance
SEBI_REGISTRATION_NUMBER=INA000000000
SEBI_REGISTERED_ENTITY=Your RIA Entity Name

# Rate Limiting (optional)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000
